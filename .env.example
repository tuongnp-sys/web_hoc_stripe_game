DATABASE_URL="postgresql://stripegame:stripegame@localhost:5432/stripegame?schema=public"

AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Cùng một giá trị; Vercel production bắt buộc
AUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
# Neon production: dùng pooled URL nếu có (host -pooler)

# Stripe TEST only (Dashboard → Test mode → API keys & Products)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_VIP=price_...

# Dev only — mock nạp (tắt trên Vercel production)
ENABLE_DEV_TOOLS=true
ADMIN_EMAILS=admin@localhost
SEED_ADMIN_PASSWORD=admin123456

# VIP Lab: build vào public/vip-lab — không cần :5173 khi npm run dev
# VIP_LAB_DEV_HMR=true
# VIP_LAB_ORIGIN=http://localhost:5173

